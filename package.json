{
  "name": "@oysterai/capture-quality",
  "version": "0.1.1",
  "description": "Camera capture-quality gating: blur, exposure, resolution, face presence and distance. Framework-free core plus a browser adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oysterai/capture-quality.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "face-api.js": "^0.22.2",
    "heic2any": "^0.0.4"
  },
  "peerDependenciesMeta": {
    "face-api.js": {
      "optional": true
    },
    "heic2any": {
      "optional": true
    }
  },
  "devDependencies": {
    "face-api.js": "^0.22.2",
    "heic2any": "^0.0.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
